# Copy to .env (gitignored) and fill in. Never commit .env.

# Contact sent in the User-Agent, required by Wikimedia's API policy.
# A project URL or an address you're comfortable publishing to Wikimedia.
WIKIPULSE_CONTACT=https://github.com/<you>/wikipulse

# Partitions for the Kafka topics. 3 is sized from the measured live rate (see docs/decisions).
KAFKA_PARTITIONS=3

# How many events between resume-point checkpoints.
CHECKPOINT_EVERY=500
